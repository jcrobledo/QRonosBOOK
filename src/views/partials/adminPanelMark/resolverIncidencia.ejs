<title><%= title %></title>
<div class="cajasAdminTrabFilter fade-in">
    <div id="contenedorCabecera" class="contenedorCabecera">
        <div class="secMenu">
            <img src="/images/inicio.png" 
                hx-get="/adminPanel" 
                hx-target="#secContenido"
                hx-push-url="true"
                style="cursor:pointer; height:3.5rem; width:3.5rem;"                
                class="iconoScale">            
        </div>
        <h2 class="correcto tituloCabecera">
            Resolución de Incidencia
        </h2>
        <div class="spacer">            
        </div>
    </div>     

    <form id="formResolverInc" class="formularioAlta">        

        <div class="fila-mixta">
            <div class="form-group-crud">
                <input class="form-control readonly-style" 
                    type="text" id="id" name="id"                      
                    value="<%= incidencia.idInc %>" readonly>
                <label class="control-label" for="id">ID Incidencia</label>
            </div>  

            <div class="form-group-crud">
                <input class="form-control readonly-style" 
                    type="text" id="idMarcaje" name="idMarcaje"                      
                    value="<%= incidencia.idFich %>" readonly>
                <label class="control-label" for="idMarcaje">ID Fichaje</label>
            </div> 
            
            <div class="form-group-crud">
                <input class="form-control readonly-style" type="text" id="dni" name="dni"
                    value="<%= incidencia.dni %>" readonly>
                <label class="control-label" for="dni">DNI</label>
            </div>
        </div> 
        
        <div class="fila-mixta">
            <div class="form-group-crud" style="flex: 1;">
                <input class="form-control readonly-style" type="text" id="nombre" name="nombre"  
                    value="<%= incidencia.nombre %>" readonly>
                <label class="control-label" for="nombre">Nombre</label>
            </div>
        

            <div class="form-group-crud" style="flex: 1;">
                <input class="form-control readonly-style" type="text" id="apellidos" name="apellidos"
                    value="<%= incidencia.apellidos %>" readonly>
                <label class="control-label" for="apellidos">Apellidos</label>
            </div>
        </div>

        <div class="fila-mixta">
            <div class="form-group-crud" style="flex: 1;">
                <input class="form-control readonly-style
                    <%= incidencia.estado === 'Aceptada' ? 'positivo_inc_consult' : '' %> 
                    <%= incidencia.estado === 'Rechazada' ? 'negativo_inc_consult' : '' %>" 
                    type="text" id="resolucion" name="resolucion"                      
                    value="<%= incidencia.estado %>" readonly>
                <label class="control-label" for="resolucion">Resolución</label>
            </div>  

            <div class="form-group-crud" style="flex: 1;">
                <input class="form-control readonly-style" 
                    type="text" id="tipoInc" name="tipoInc"                      
                    value="<%= incidencia.tipoInc %>" readonly>
                <label class="control-label" for="tipoInc">Tipo Incidencia</label>
            </div> 
        </div> 

        <div class="fila-mixta" style="justify-content: center;">
            <div class="form-group-crud">
                <input class="form-control readonly-style" 
                    type="date" id="fechaFich" name="fechaFich"                
                    value="<%= incidencia.date %>" readonly>
                <label class="control-label" for="fechaFich">Fecha Fichaje</label>
            </div>
        
            <div class="form-group-crud">
                <input class="form-control readonly-style" 
                    type="text" id="horaFich" name="horaFich"                 
                    value="<%= incidencia.time.slice(0, 5) %>" readonly>
                <label class="control-label" for="horaFich">Hora Fichaje</label>
            </div>      
        
            <% if (incidencia.tipoInc === 'Modificar Fichaje') { %>
                <div class="form-group-crud">
                    <input class="form-control readonly-style" 
                        type="text" id="horaNewFich" name="horaNewFich"                 
                        value="<%= incidencia.timeChange.slice(0, 5) %>" readonly>
                    <label class="control-label" for="horaNewFich">Hora Nueva</label>
                </div>
            <% } %>
        </div>

        <div class="fila-botones-centro-resol" style="margin-top: 10px;">
            <button type="button" 
                hx-get="/adminPanel/incidencias" 
                hx-target="#secContenido"
                hx-push-url="true"
                style="width: 200px;">
                Volver  
            </button>             
            <button type="button" 
                onclick="document.getElementById('modalRechazar').style.display='flex'"               
                style="width: 200px;">
                Rechazar Incidencia
            </button>
            <button type="button" 
                onclick="document.getElementById('modalAceptar').style.display='flex'"
                style="width: 200px;">
                Aceptar Incidencia  
            </button>       
        </div>
    </form>  
    
    <div id="modalRechazar" hx-swap-oob="true" class="modal-overlay" style="display:none;">
        <div class="modal-content">        
            <h3>¿Rechazar Incidencia?</h3>
            <p>Esta acción es permanente y no se puede deshacer.</p>
        
            <div class="fila-botones"> 
                <button type="button" onclick="document.getElementById('modalRechazar').style.display='none'">
                    Cancelar
                </button>           
                <button type="button" 
                    hx-put="/adminPanel/incidencias/rechazar/<%= incidencia.idInc %>"
                    hx-include="#formResolverInc"
                    hx-target="#secContenido"
                    hx-on::after-request="document.getElementById('modalRechazar').style.display='none'">
                    Rechazar
                </button>                
            </div>
        </div>
    </div>

    <div id="modalAceptar" hx-swap-oob="true" class="modal-overlay" style="display:none;">
        <div class="modal-content">        
            <h3  style="color: darkgreen;">¿Aceptar Incidencia?</h3>
            <p>Esta acción es permanente y no se puede deshacer.</p>
        
            <div class="fila-botones"> 
                <button type="button" onclick="document.getElementById('modalAceptar').style.display='none'">
                    Cancelar
                </button>           
                <button type="button" 
                    hx-put="/adminPanel/incidencias/aceptar/<%= incidencia.idInc %>"
                    hx-include="#formResolverInc"
                    hx-target="#secContenido"
                    hx-on::after-request="document.getElementById('modalAceptar').style.display='none'">
                    Aceptar
                </button>                
            </div>
        </div>
    </div>

</div>



