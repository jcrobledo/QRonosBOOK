<title><%= title %></title>
<div class="cajasAdminTrabFilter fade-in">
    <div id="contenedorCabecera" class="contenedorCabecera">
        <div class="secMenu">
            <img src="/images/inicio.png" 
                hx-get="/adminPanel" 
                hx-target="#secContenido"
                hx-push-url="true"
                style="cursor:pointer; height:3.5rem; width:3.5rem;"                
                class="iconoScale">            
        </div>
        <h2 class="correcto tituloCabecera">
            <span class="texto-largo">Gestión de </span>Incidencias
        </h2>    
        <div class="spacer">            
        </div>    
    </div>

    <div class="formularioFiltroBtn">            
        <button id="botonFiltros" onclick="mostrarFormulario()" style="width: 200px;">Ocultar Filtros</button>
    </div>

    <form class="formularioFiltro"
        hx-get="/adminPanel/incidencias" 
        hx-target="#secContenido" 
        hx-push-url="true">   
        
        <div class="form-group-filtro">
            <input class="form-control input-dni" type="text" id="idInc" name="idInc" maxlength="5" pattern="\[0-9]{1,5}"
                autocomplete="off" placeholder=" "
                title="De 1 a 5 números"
                value="<%= filtros.idInc %>">
            <label class="control-label" for="idInc">ID Inc</label>
        </div>

        <div class="form-group-filtro">
            <input class="form-control input-id" type="text" id="idFich" name="idFich" maxlength="12" pattern="\[0-9]{1,12}"
                autocomplete="off" placeholder=" "
                title="De 1 a 12 números"
                value="<%= filtros.idFich %>">
            <label class="control-label" for="idFich">ID Fich</label>
        </div>

        <div class="form-group-filtro">
            <input class="form-control input-dni" type="text" id="dniFiltro" name="dni" maxlength="9" pattern="([0-9]{1,8}[a-zA-Z]?)|([a-zA-Z]{1})"
                autocomplete="off" placeholder=" "
                title="De 1 a 8 números o una letra y debe ir al final (sin ñ/Ñ)"
                value="<%= filtros.dni %>">
            <label class="control-label" for="dniFiltro">DNI</label>
        </div>

        <div class="form-group-filtro">
            <input class="form-control input-nombre" type="text" id="nombre" name="nombre" maxlength="25" pattern="[a-zA-ZáéíóúÁÉÍÓÚñÑ \-]{1,25}"
                autocomplete="off" placeholder=" " title="Solo letras, máximo 25 caracteres"
                value="<%= filtros.nombre %>">
            <label class="control-label" for="nombre">Nombre</label>
        </div>

        <div class="form-group-filtro">
            <input class="form-control input-apellidos" type="text" id="apellidos" name="apellidos" maxlength="50"
                pattern="[a-zA-ZáéíóúÁÉÍÓÚñÑ \-]{1,50}" autocomplete="off" placeholder=" " title="Solo letras, máximo 50 caracteres"
                value="<%= filtros.apellidos %>">
            <label class="control-label" for="apellidos">Apellidos</label>
        </div>  
        
        <div class="contenedor-filtros-tabla-admin">
        
        <div class="selector-segmentado">
            <input type="radio" 
                name="estado" 
                id="todas" 
                value="todas"
                hx-get="/adminPanel/incidencias"
                hx-target="#secContenido"
                hx-include=".formularioFiltro"
                hx-trigger="change" 
                <%= filtros.estado === 'todas' ? 'checked' : '' %>>
            <label for="todas">Todas</label>

            <input type="radio" 
                name="estado" 
                id="aceptadas" 
                value="aceptada"
                hx-get="/adminPanel/incidencias"
                hx-target="#secContenido"
                hx-include=".formularioFiltro"
                hx-trigger="change"
                <%= filtros.estado === 'aceptada' ? 'checked' : '' %>>
            <label for="aceptadas">Aceptadas</label>

            <input type="radio" 
                name="estado" 
                id="rechazadas" 
                value="rechazada"
                hx-get="/adminPanel/incidencias"
                hx-target="#secContenido"
                hx-include=".formularioFiltro"
                hx-trigger="change"
                <%= filtros.estado === 'rechazada' ? 'checked' : '' %>>
            <label for="rechazadas">Rechazadas</label>

            <input type="radio" 
                name="estado" 
                id="pendientes" 
                value="pendiente"
                hx-get="/adminPanel/incidencias"
                hx-target="#secContenido"
                hx-include=".formularioFiltro"
                hx-trigger="change"
                <%= filtros.estado === 'pendiente' ? 'checked' : '' %>>
            <label for="pendientes">Pendientes</label>
        </div>

    </div>

        <div class="fila-botones">
            <button type="submit">Filtrar</button>
            <button type="button" 
                hx-get="/adminPanel/incidencias" 
                hx-target="#secContenido"
                hx-push-url="true">
                Limpiar
            </button>
        </div>

    </form>
</div>

<div class="cajasAdminTrabTable fade-in">      
 
    <table class="tablaTrabajadores">
        <thead>
            <tr>
                <th hx-get="/adminPanel/incidencias?sort=idInc&dir=<%= currentDir === 'ASC' ? 'DESC' : 'ASC' %>"
                    hx-target="#secContenido"
                    hx-include=".formularioFiltro"
                    class="<%= currentSort === 'idInc' ? 'sort-' + currentDir.toLowerCase() : '' %>" style="width: 80px;">
                ID Inc</th>
                <th hx-get="/adminPanel/incidencias?sort=idFich&dir=<%= currentDir === 'ASC' ? 'DESC' : 'ASC' %>"
                    hx-target="#secContenido"
                    hx-include=".formularioFiltro"
                    class="<%= currentSort === 'idFich' ? 'sort-' + currentDir.toLowerCase() : '' %>" style="width: 120px;">
                ID FIch</th>
                <th hx-get="/adminPanel/incidencias?sort=dni&dir=<%= currentDir === 'ASC' ? 'DESC' : 'ASC' %>"
                    hx-target="#secContenido"
                    hx-include=".formularioFiltro"
                    class="<%= currentSort === 'dni' ? 'sort-' + currentDir.toLowerCase() : '' %>" style="width: 110px;"> 
                DNI</th>
                <th hx-get="/adminPanel/incidencias?sort=nombre&dir=<%= currentDir === 'ASC' ? 'DESC' : 'ASC' %>"
                    hx-target="#secContenido"
                    hx-include=".formularioFiltro"
                    class="<%= currentSort === 'nombre' ? 'sort-' + currentDir.toLowerCase() : '' %>">
                Nombre</th>
                <th hx-get="/adminPanel/incidencias?sort=apellidos&dir=<%= currentDir === 'ASC' ? 'DESC' : 'ASC' %>"
                    hx-target="#secContenido"
                    hx-include=".formularioFiltro"
                    class="<%= currentSort === 'apellidos' ? 'sort-' + currentDir.toLowerCase() : '' %>">
                Apellidos</th>
                <th hx-get="/adminPanel/incidencias?sort=tipoInc&dir=<%= currentDir === 'ASC' ? 'DESC' : 'ASC' %>"
                    hx-target="#secContenido"
                    hx-include=".formularioFiltro"
                    class="<%= currentSort === 'tipoInc' ? 'sort-' + currentDir.toLowerCase() : '' %>" style="width: 150px;">
                Tipo Inc</th>
                <th hx-get="/adminPanel/incidencias?sort=estado&dir=<%= currentDir === 'ASC' ? 'DESC' : 'ASC' %>"
                    hx-target="#secContenido"
                    hx-include=".formularioFiltro"
                    class="<%= currentSort === 'estado' ? 'sort-' + currentDir.toLowerCase() : '' %>" style="width: 80px;">
                Resolución</th>                
                <th class="no-sort" style="width: 110px;">Acciones</th>
            </tr>
        </thead>
        <tbody id="tablaTrabajadoresBody">
            <% incidencias.forEach(function(incidencia) { %>
            <tr class="<%= incidencia.estado === 'Aceptada' ? 'positivo_inc' : (incidencia.estado === 'Rechazada' ? 'negativo_inc' : '') %>">
                <td><%= incidencia.idInc %></td>
                <td><%= incidencia.idFich %></td>
                <td><%= incidencia.dni %></td>
                <td><%= incidencia.nombre %></td> 
                <td><%= incidencia.apellidos %></td>  
                <td><%= incidencia.tipoInc %></td>
                <td><%= incidencia.estado %></td>                               
                <td class="celda-menu">
                    <button class="btnAcciones">&middot;&middot;&middot;</button>
                    <div class="dropdown-table">
                        <ul>                            
                            <li><a href="/adminPanel/incidencias/consultar/<%= incidencia.idInc %>?from=listIncidencias"
                                hx-get="/adminPanel/incidencias/consultar/<%= incidencia.idInc %>?from=listIncidencias"
                                hx-target="#secContenido"
                                hx-swap="innerHTML show:window:top"
                                hx-push-url="true">
                                Ver Incidencia
                                </a>
                            </li>                                                    
                            <li>
                                <% if (incidencia.estado === 'Pendiente') { %>
                                    <a href="/adminPanel/incidencias/resolver/<%= incidencia.idInc %>"
                                        hx-get="/adminPanel/incidencias/resolver/<%= incidencia.idInc %>"
                                        hx-target="#secContenido"
                                        hx-swap="innerHTML show:window:top"
                                        hx-push-url="true">
                                        Resolver Incidencia
                                    </a>
                                <% } else { %>
                                    <span class="incidencia-disabled">
                                        Resolver Incidencia
                                    </span>
                                <% } %>
                            </li>                            
                        </ul>
                    </div>
                </td>                             
            </tr>
        <% }); %>                
        </tbody>
    </table>

    <div class="info-paginacion">
    
        <div class="contador-resultados">
            Mostrando <strong><%= desde %></strong> a <strong><%= hasta %></strong> de <strong><%= totalCount %></strong> fichajes
        </div>    
        <div class="botones-paginacion">
            <% if (currentPage > 1) { %>
                <button hx-get="/adminPanel/fichajes?page=<%= currentPage - 1 %>&sort=<%= currentSort %>&dir=<%= currentDir %>&fecha=<%= filtros.fecha %>" 
                        hx-include=".formularioFiltro" 
                        hx-target="#secContenido"
                        class="btn-pag">Anterior</button>
            <% } %>

            <% if (currentPage < totalPages) { %>
                <button hx-get="/adminPanel/fichajes?page=<%= currentPage + 1 %>&sort=<%= currentSort %>&dir=<%= currentDir %>&fecha=<%= filtros.fecha %>" 
                        hx-include=".formularioFiltro" 
                        hx-target="#secContenido"
                        class="btn-pag">Siguiente</button>
            <% } %>
        </div>
    </div>

</div>

<script>
    function mostrarFormulario() {
        const formulario = document.querySelector('.formularioFiltro');
        formulario.classList.toggle('escondido');

        if (formulario.classList.contains('escondido')) {
            botonFiltros.innerText = "Ver Filtros";
        } else {
            botonFiltros.innerText = "Ocultar Filtros";
        };
    };
</script>

