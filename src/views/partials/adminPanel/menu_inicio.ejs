<title><%= title %></title>
<div class="cajasPrincipales fade-in"  style="padding-top: 60px;">
    <section>
        <div class="content">
            <div class="icon" 
                hx-get="/adminPanel/trabajadores" 
                hx-target="#secContenido" 
                hx-push-url="true"
                style="cursor:pointer">
                <img src="/images/trabajadores.png" style="height:7rem;width:7rem" class="iconoScale">
            </div>
            <h3 class="h3_eleMenu" 
                hx-get="/adminPanel/trabajadores" 
                hx-target="#secContenido" 
                hx-push-url="true"
                style="cursor:pointer"
                data-text="Trabajadores">
                Trabajadores
            </h3>
        </div>
    </section>
    <section>
        <div class="content">
            <div class="icon"
                hx-get="/adminPanel/administradores" 
                hx-target="#secContenido" 
                hx-push-url="true"
                style="cursor:pointer">
                <img src="/images/administradores.png" style="height:7rem;width:7rem" class="iconoScale">
            </div>            
            <h3 class="h3_eleMenu"
                hx-get="/adminPanel/administradores" 
                hx-target="#secContenido" 
                hx-push-url="true"
                style="cursor:pointer"
                data-text="Administradores">
                Administradores
            </h3>            
        </div>
    </section>
    <section>
        <div class="content">
            <div class="icon"
                hx-get="/adminPanel/departamentos" 
                hx-target="#secContenido" 
                hx-push-url="true"
                style="cursor:pointer">
                <img src="/images/departamentos.png" style="height:7rem;width:7rem" class="iconoScale">
            </div>
            <h3 class="h3_eleMenu"
                hx-get="/adminPanel/departamentos" 
                hx-target="#secContenido" 
                hx-push-url="true"
                style="cursor:pointer"
                data-text="Departamentos">
                Departamentos
            </h3>            
        </div>
    </section>
    <section>
        <div class="content">
            <div class="icon"
                hx-get="/adminPanel/fichajes" 
                hx-target="#secContenido" 
                hx-push-url="true"
                style="cursor:pointer">
                <img src="/images/fichajes.png" style="height:7rem;width:7rem" class="iconoScale">
            </div>
            <h3 class="h3_eleMenu"
                hx-get="/adminPanel/fichajes" 
                hx-target="#secContenido" 
                hx-push-url="true"
                style="cursor:pointer"
                data-text="Fichajes">
                Fichajes
            </h3>        
        </div>
    </section>
    <section>
        <div class="content">
            <div class="icon"
                hx-get="/adminPanel/incidencias" 
                hx-target="#secContenido" 
                hx-push-url="true"
                style="cursor:pointer">
                <img src="/images/<%= countIncPendientes > 0 ? 'incidenciasHas.png' : 'incidencias.png' %>" style="height:7rem;width:7rem" class="iconoScale">
            </div>
            <h3 class="h3_eleMenu"
                hx-get="/adminPanel/Incidencias" 
                hx-target="#secContenido" 
                hx-push-url="true"
                style="cursor:pointer"
                <% let textoFinal = countIncPendientes > 0 ? `Incidencias (${countIncPendientes})` : 'Incidencias' %>
                data-text="<%= textoFinal %>">
                <%= textoFinal %>
            </h3>  
        </div>
    </section>
</div>

<script src="/socket.io/socket.io.js"></script>

<script>

{ // Usamos un bloque para evitar errores de "already declared" por const socket

const socket = io();
    
socket.on('EjecutarRecargaMenuInicio', () => {
    // console.log('Menú Inicio Actualizado'); // El navegador reacciona al evento del servidor    
    window.location.reload();
});

}

</script>
