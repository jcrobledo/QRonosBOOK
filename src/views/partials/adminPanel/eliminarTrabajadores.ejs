<title><%= title %></title>
<div class="cajasAdminTrabFilter fade-in">
    <div id="contenedorCabecera" class="contenedorCabecera">
        <div class="secMenu">
            <img src="/images/inicio.png" 
                hx-get="/adminPanel" 
                hx-target="#secContenido"
                hx-push-url="true"
                style="cursor:pointer; height:3.5rem; width:3.5rem;"                
                class="iconoScale">            
        </div>
        <h2 class="correcto tituloCabecera">
            Eliminación de Trabajadores
        </h2>
        <div class="spacer">            
        </div>
    </div>    

    <% if (tieneMarcajes) { %>
        <div class="contenedor-alertas-crud" id="alertaError"> 
            <div class="alert-style-crud-ko">
                <span>⛔</span>
                <p><strong>EL TRABAJADOR NO PUEDE SER ELIMINADO</strong><br><br>
                <strong>LEY RDL 8/2019</strong><br>Exige la conservación<br> de los fichajes durante al menos cuatro años</p>
            </div>
        </div>
    <% } %> 

    <form id="formEliminar" 
        class="formularioAlta"
        hx-delete="/adminPanel/trabajadores/eliminar/<%= trabajador.dni %>"  
        hx-target="#secContenido" 
        hx-push-url="false">

        <div class="fila-mixta">
            <div class="form-group-crud">
                <input class="form-control input-dni readonly-style" type="text" id="ConfirmDni"
                    value="<%= trabajador.dni %>" readonly>
                <label class="control-label" for="ConfirmDni">DNI</label>
            </div>

            <div class="form-group-crud">
                <input class="form-control input-nombre readonly-style" type="text" id="nombre"  
                     value="<%= trabajador.nombre %>" readonly>
                <label class="control-label" for="nombre">Nombre</label>
            </div>
        </div>

        <div class="form-group-crud">
            <input class="form-control readonly-style" type="text" id="apellidos"
                value="<%= trabajador.apellidos %>" readonly>
            <label class="control-label" for="apellidos">Apellidos</label>
        </div>

        <div class="form-group-crud">
            <input class="form-control readonly-style" type="email" id="email" autocomplete="off"
                value="<%= trabajador.email %>" readonly>
            <label class="control-label" for="email">Email</label>
        </div>

        <div class="form-group-crud">
            <input class="form-control readonly-style" type="text" id="departamento"
                value="<%= departamentoNombre %>" readonly>
            <label class="control-label" for="departamento">Departamento</label>
        </div>

        <div class="fila-botones">
            <button type="button" 
                hx-get="/adminPanel/trabajadores" 
                hx-target="#secContenido"
                hx-push-url="true">
                Volver
            </button>
            <% if (!tieneMarcajes) { %>
                <button type="button" onclick="document.getElementById('modalConfirmar').style.display='flex'">
                    Eliminar
                </button>     
            <% } %>       
        </div>
    </form> 
    
    <div id="modalConfirmar" hx-swap-oob="true" class="modal-overlay" style="display:none;">
        <div class="modal-content">        
            <h3>¿Eliminar al Trabajador?</h3>
            <p>Esta acción es permanente y no se puede deshacer.</p>
        
            <div class="fila-botones"> 
                <button type="button" onclick="document.getElementById('modalConfirmar').style.display='none'">
                    Cancelar
                </button>           
                <button type="button" 
                hx-on:click="document.getElementById('modalConfirmar').style.display='none'"
                onclick="htmx.trigger('#formEliminar', 'submit')">
                    Eliminar
                </button>                
            </div>
        </div>
    </div>
    
</div>



