<div class="cajasAdminTrabFilter fade-in">
    <div id="contenedorCabecera" class="contenedorCabecera">
        <div class="secMenu">
            <img src="/images/inicio.png" 
                hx-get="/adminPanel" 
                hx-target="#secContenido"
                hx-push-url="true"
                style="cursor:pointer; height:3.5rem; width:3.5rem;"                
                class="iconoScale">            
        </div>
        <h2 class="correcto tituloCabecera">
            Cambiar Contraseña de Trabajadores
        </h2>
        <div class="spacer">            
        </div>
    </div>     

    <form class="formularioAlta"        
        hx-put="/adminPanel/trabajadores/cambiarPass/<%= trabajador.dni %>" 
        hx-target="#secContenido" 
        hx-push-url="false">

        <div class="fila-mixta">
            <div class="form-group-crud">
                <input class="form-control input-dni readonly-style" type="text" id="confirmDni" name="dni"
                    value="<%= trabajador.dni %>" readonly>
                <label class="control-label" for="confirmDni">DNI</label>
            </div>

            <div class="form-group-crud">
                <input class="form-control input-nombre readonly-style" type="text" id="nombre" name="nombre"
                     value="<%= trabajador.nombre %>" readonly>
                <label class="control-label" for="nombre">Nombre</label>
            </div>
        </div>

        <div class="form-group-crud">
            <input class="form-control readonly-style" type="text" id="apellidos" name="apellidos"
                value="<%= trabajador.apellidos %>" readonly>
            <label class="control-label" for="apellidos">Apellidos</label>
        </div>  
        
        <div class="form-group-crud">
            <input class="form-control readonly-style" type="email" id="email" autocomplete="off" name="email"
                value="<%= trabajador.email %>" readonly>
            <label class="control-label" for="email">Email</label>
        </div>

        <div class="fila-mixta-password">
            <button type="button" class="btn-pag" onclick="generarPassword()">Autogenerar</button>

            <div class="form-group-crud">
                <input class="form-control input-password" type="text" id="password" name="password" maxlength="8" minlength="8"
                    pattern="^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!@#$%&*+])[a-zA-Z\d!@#$%&*+]{8}$" autocomplete="off" placeholder=" " required
                    title="8 caracteres y al menos 1 mayúscula, 1 minúscula, 1 número, 1 carácter especial (!, @, $, %, &, *, +, #)  y sin espacios">
                <label class="control-label" for="password">Contraseña</label>
            </div>
        </div>

        <div class="fila-botones">
            <button type="button" 
                hx-get="/adminPanel/trabajadores" 
                hx-target="#secContenido"
                hx-push-url="true">
                Volver
            </button>
            <button type="submit">Cambiar</button>            
        </div>
    </form>    
</div>

<script>    

    function generarPassword() {
        const minusculas = "abcdefghijklmnopqrstuvwxyz";
        const mayusculas = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        const numeros = "0123456789";
        const especiales = "!@#$%&*+#"; // Los que definiste en tu pattern
        const todos = minusculas + mayusculas + numeros + especiales;

        let password = "";

        // 1. Aseguramos al menos uno de cada tipo para cumplir el pattern
        password += minusculas.charAt(Math.floor(Math.random() * minusculas.length));
        password += mayusculas.charAt(Math.floor(Math.random() * mayusculas.length));
        password += numeros.charAt(Math.floor(Math.random() * numeros.length));
        password += especiales.charAt(Math.floor(Math.random() * especiales.length));

        // 2. Rellenamos los 4 restantes aleatoriamente hasta llegar a 8
        for (let i = 0; i < 4; i++) {
            password += todos.charAt(Math.floor(Math.random() * todos.length));
        }

        // 3. Mezclamos los caracteres para que no sigan siempre el mismo orden
        password = password.split('').sort(() => 0.5 - Math.random()).join('');

        // 4. Insertamos en el input y disparamos el evento input para que el label suba
        const inputPass = document.getElementById('password');
        inputPass.value = password;
    
        // Esto asegura que el label flote (especialmente si usas :not(:placeholder-shown))
        inputPass.dispatchEvent(new Event('input')); 
    }    

</script>





