<div class="cajasAdminTrabFilter fade-in">
    <div id="contenedorCabecera" class="contenedorCabecera">
        <div class="secMenu">
            <img src="/images/inicio.png" 
                hx-get="/adminPanel" 
                hx-target="#secContenido"
                hx-push-url="true"
                style="cursor:pointer; height:3.5rem; width:3.5rem;"                
                class="iconoScale">            
        </div>
        <h2 class="correcto tituloCabecera">
            <span class="texto-largo">Gestión de</span> Trabajadores y Fichajes
        </h2>
        <div class="spacer">
            <button type="button"
                hx-get="/adminPanel/trabajadores/alta" 
                hx-target="#secContenido"
                hx-push-url="true" 
                class="btFichaje">Nuevo Trabajador</button>
        </div>
    </div>

    <div class="formularioFiltroBtn">            
        <button id="botonFiltros" onclick="mostrarFormulario()" style="width: 200px;">Ocultar Filtros</button>
    </div>

    <form class="formularioFiltro"
        hx-get="/adminPanel/trabajadores" 
        hx-target="#secContenido" 
        hx-push-url="true">

        <div class="form-group-filtro">
            <input class="form-control input-dni" type="text" id="dniFiltro" name="dni" maxlength="9" pattern="([0-9]{1,8}[a-zA-Z]?)|([a-zA-Z]{1})"
                autocomplete="off" placeholder=" "
                title="De 1 a 8 números o una letra y debe ir al final (sin ñ/Ñ)"
                value="<%= filtros.dni %>">
            <label class="control-label" for="dniFiltro">DNI</label>
        </div>

        <div class="form-group-filtro">
            <input class="form-control input-nombre" type="text" id="nombre" name="nombre" maxlength="25" pattern="[a-zA-ZáéíóúÁÉÍÓÚñÑ \-]{1,25}"
                autocomplete="off" placeholder=" " title="Solo letras, máximo 25 caracteres"
                value="<%= filtros.nombre %>">
            <label class="control-label" for="nombre">Nombre</label>
        </div>

        <div class="form-group-filtro">
            <input class="form-control input-apellidos" type="text" id="apellidos" name="apellidos" maxlength="50"
                pattern="[a-zA-ZáéíóúÁÉÍÓÚñÑ \-]{1,50}" autocomplete="off" placeholder=" " title="Solo letras, máximo 50 caracteres"
                value="<%= filtros.apellidos %>">
            <label class="control-label" for="apellidos">Apellidos</label>
        </div>

        <div class="form-group-filtro">
            <input class="form-control input-departamento" type="text" id="departamento" name="departamento" maxlength="50"
                pattern="[a-zA-ZáéíóúÁÉÍÓÚñÑ \-]{1,50}" autocomplete="off" placeholder=" " title="Solo letras, máximo 50 caracteres"
                value="<%= filtros.departamento %>">
            <label class="control-label" for="departamento">Departamento</label>
        </div>

        <div class="fila-botones">
            <button type="submit">Filtrar</button>
            <button type="button" 
                hx-get="/adminPanel/trabajadores" 
                hx-target="#secContenido"
                hx-push-url="true">
                Limpiar
            </button>
        </div>

    </form>
</div>

<div class="cajasAdminTrabTable fade-in">    
    <table class="tablaTrabajadores">
        <thead>
            <tr>
                <th hx-get="/adminPanel/trabajadores?sort=dni&dir=<%= currentDir === 'ASC' ? 'DESC' : 'ASC' %>"
                    hx-target="#secContenido"
                    hx-include=".formularioFiltro"
                    class="<%= currentSort === 'dni' ? 'sort-' + currentDir.toLowerCase() : '' %>">
                DNI</th>
                <th hx-get="/adminPanel/trabajadores?sort=nombre&dir=<%= currentDir === 'ASC' ? 'DESC' : 'ASC' %>"
                    hx-target="#secContenido"
                    hx-include=".formularioFiltro"
                    class="<%= currentSort === 'nombre' ? 'sort-' + currentDir.toLowerCase() : '' %>"> 
                Nombre</th>
                <th hx-get="/adminPanel/trabajadores?sort=apellidos&dir=<%= currentDir === 'ASC' ? 'DESC' : 'ASC' %>"
                    hx-target="#secContenido"
                    hx-include=".formularioFiltro"
                    class="<%= currentSort === 'apellidos' ? 'sort-' + currentDir.toLowerCase() : '' %>">
                Apellidos</th>
                <th hx-get="/adminPanel/trabajadores?sort=email&dir=<%= currentDir === 'ASC' ? 'DESC' : 'ASC' %>"
                    hx-target="#secContenido"
                    hx-include=".formularioFiltro"
                    class="<%= currentSort === 'email' ? 'sort-' + currentDir.toLowerCase() : '' %>">
                Email</th>
                <th hx-get="/adminPanel/trabajadores?sort=departamento&dir=<%= currentDir === 'ASC' ? 'DESC' : 'ASC' %>"
                    hx-target="#secContenido"
                    hx-include=".formularioFiltro"
                    class="<%= currentSort === 'departamento' ? 'sort-' + currentDir.toLowerCase() : '' %>">
                Departamento</th>
                <th class="no-sort">Acciones</th>
            </tr>
        </thead>
        <tbody id="tablaTrabajadoresBody">
            <% trabajadores.forEach(function(trabajador) { %>
            <tr>
                <td><%= trabajador.dni %></td>
                <td><%= trabajador.nombre %></td> 
                <td><%= trabajador.apellidos %></td>  
                <td><%= trabajador.email %></td>  
                <td><%= departamentoMap[trabajador.departamento] ? departamentoMap[trabajador.departamento] : "Sin departamento" %></td>  
                <td class="celda-menu">
                    <button class="btnAcciones">&middot;&middot;&middot;</button>
                    <div class="dropdown-table">
                        <ul>
                            <li><a href="/modificar/<%= trabajador.dni %>">Modificar</a></li>
                            <li><a href="/eliminar/<%= trabajador.dni %>">Eliminar</a></li>
                            <li><a href="/fichajes/<%= trabajador.dni %>">Ver fichajes</a></li>
                        </ul>
                    </div>
                </td>                             
            </tr>
        <% }); %>                
        </tbody>
    </table>

    <div class="info-paginacion">
    
        <div class="contador-resultados">
            Mostrando <strong><%= desde %></strong> a <strong><%= hasta %></strong> de <strong><%= totalCount %></strong> trabajadores
        </div>    
        <div class="botones-paginacion">
            <% if (currentPage > 1) { %>
                <button hx-get="/adminPanel/trabajadores?page=<%= currentPage - 1 %>&sort=<%= currentSort %>&dir=<%= currentDir %>" 
                        hx-include=".formularioFiltro" 
                        hx-target="#secContenido"
                        class="btn-pag">Anterior</button>
            <% } %>

            <% if (currentPage < totalPages) { %>
                <button hx-get="/adminPanel/trabajadores?page=<%= currentPage + 1 %>&sort=<%= currentSort %>&dir=<%= currentDir %>" 
                        hx-include=".formularioFiltro" 
                        hx-target="#secContenido"
                        class="btn-pag">Siguiente</button>
            <% } %>
        </div>
    </div>

</div>

<script>
    function mostrarFormulario() {
        const formulario = document.querySelector('.formularioFiltro');
        formulario.classList.toggle('escondido');

        if (formulario.classList.contains('escondido')) {
            botonFiltros.innerText = "Ver Filtros";
        } else {
            botonFiltros.innerText = "Ocultar Filtros";
        };
    };
</script>

