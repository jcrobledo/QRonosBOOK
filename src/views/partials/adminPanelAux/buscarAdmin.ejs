<div class="cajasAdminTrabFilter fade-in">
    <div id="contenedorCabecera" class="contenedorCabecera">
        <div class="secMenu">
            <img src="/images/inicio.png" 
                hx-get="/adminPanel" 
                hx-target="#secContenido"
                hx-push-url="true"
                style="cursor:pointer; height:3.5rem; width:3.5rem;"                
                class="iconoScale">            
        </div>
        <h2 class="correcto tituloCabecera">
            <%= (typeof mensajeOK !== 'undefined' && mensajeOK === 'OK') ? 'Alta de Administradores' : 'Buscar Administradores' %>
        </h2>
        <div class="spacer">            
        </div>
    </div>   

    <% if (typeof mensajeOK === 'undefined' || mensajeOK !== 'OK') { %>
        <div class="contenedor-alertas-crud">            
            <div class="info-style-crud">            
                <span>⚠️</span>
                <p>Los Administradores tienen que estar dados de ALTA como Trabajadores</p>
            </div>        
        </div>
    <% } %>

    <form class="formularioAlta" id="myForm"
        hx-post="/adminPanel/administradores/buscar" 
        hx-target="#secContenido"         
        hx-push-url="false">

        <div class="fila-mixta-buscar">
            <div class="form-group-crud">
                <input class="form-control input-dni <%= (typeof mensajeOK !== 'undefined' && mensajeOK === 'OK') ? 'readonly-style' : '' %>" 
                    type="text" id="dni" name="dni" maxlength="9" minlength="9"
                    pattern=".{8}[A-Z]" autocomplete="off" placeholder=" " required
                    title="9 caracteres. 8 números consecutivos y una letra MAYÚSCULA al final"
                    value="<%= administrador ? administrador.dni : '' %>"
                    <%= (typeof mensajeOK !== 'undefined' && mensajeOK === 'OK') ? 'readonly' : '' %>>
                <label class="control-label" for="dni">DNI</label>
            </div>

            <button type="submit" 
                class="btn-buscar" 
                <% if (typeof mensajeOK !== 'undefined' && mensajeOK === 'OK') { %> 
                disabled style="display:none;" <% } %>>
                Buscar
            </button>                 
        </div>

        <div class="form-group-crud">
                <input class="form-control readonly-style" type="text" id="nombre" name="nombre" placeholder=" " readonly
                value="<%= administrador ? administrador.nombre : '' %>">
                <label class="control-label" for="nombre">Nombre</label>
        </div>

        <div class="form-group-crud">
            <input class="form-control readonly-style" type="text" id="apellidos" name="apellidos" placeholder=" " readonly
            value="<%= administrador ? administrador.apellidos : '' %>">
            <label class="control-label" for="apellidos">Apellidos</label>
        </div>

        <div class="form-group-crud">
            <input class="form-control readonly-style" style="margin-bottom: 15px;" type="email" id="email" name="email" 
            autocomplete="off" placeholder=" " readonly 
            value="<%= administrador ? administrador.email : '' %>">
            <label class="control-label" for="email">Email</label>
        </div>

        <div class="fila-botones">
            <button type="button" 
                hx-get="/adminPanel/administradores" 
                hx-target="#secContenido"
                hx-push-url="true">
                Volver
            </button>  
            <% if (typeof mensajeOK !== 'undefined' && mensajeOK === 'OK') { %>
                <button type="button" 
                    class="btn-alta"
                    hx-post="/adminPanel/administradores/alta" 
                    hx-include=".formularioAlta"
                    hx-target="#secContenido">
                    Alta
                </button>
            <% } %>                
        </div>

    </form>

    <% if (typeof mensajeError !== 'undefined' && mensajeError) { %>
        <div class="contenedor-alertas-crud" id="alertaError" style="margin-top: 20px;"> 
            <div class="alert-style-crud-ko">
                <span>⛔</span>
                <p><%= mensajeError %></p>
            </div>
        </div>
    <% } %> 

</div>

<script>

    (function() {
        const elemento = document.getElementById('alertaError');
        if (elemento) {
            setTimeout(() => {elemento.style.display = 'none';}, 4000);
        }
    })();

</script>

