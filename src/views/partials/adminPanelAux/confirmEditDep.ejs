<title><%= title %></title>
<div class="cajasAdminTrabFilter fade-in">
    <div id="contenedorCabecera" class="contenedorCabecera">
        <div class="secMenu">
            <img src="/images/inicio.png" 
                hx-get="/adminPanel" 
                hx-target="#secContenido"
                hx-push-url="true"
                style="cursor:pointer; height:3.5rem; width:3.5rem;"                
                class="iconoScale">            
        </div>
        <h2 class="correcto tituloCabecera">
            <%= mensajeKO ? 'Error Modificación Departamento' : 'Confirmación Modificación Departamento' %>
        </h2>
        <div class="spacer">            
        </div>
    </div> 

    <div class="contenedor-alertas-crud">    
        <% if (typeof mensajeKO !== 'undefined' && mensajeKO) { %>
            <div class="alert-style-crud-ko">
                <span>⛔</span>
                <p><%- mensajeKO %></p>
            </div>
        <% } %>
        <% if (typeof mensajeOK !== 'undefined' && mensajeOK) { %>
            <div class="alert-style-crud-ok">
                <span class="icono-check">&#10004;</span>
                <p><%- mensajeOK %></p>
            </div>
        <% } %>
    </div>

    <form class="formularioAlta">
        <div class="form-group-crud" style="margin-bottom: 20px;">
            <input class="form-control readonly-style input-nombre-dep" type="text" id="nombre"
                value="<%= nombreDep %>" readonly>
            <label class="control-label" for="nombre">Nombre Departamento</label>
        </div>        

        <div class="fila-botones">
            <button type="button" 
                hx-get="/adminPanel/departamentos" 
                hx-target="#secContenido"
                hx-push-url="true">
                Volver  
            </button>                    
        </div>
    </form>    
</div>



