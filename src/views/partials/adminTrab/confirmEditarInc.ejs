<title><%= title %></title>
<div class="cajasAdminTrabFilter fade-in">
    <div id="contenedorCabecera" class="contenedorCabecera">
        <div class="secMenu">
            <img src="/images/inicio.png" 
                hx-get="/trabPanel" 
                hx-target="#secContenido"
                hx-push-url="true"
                style="cursor:pointer; height:3.5rem; width:3.5rem;"                
                class="iconoScale">            
        </div>
        <h2 class="correcto tituloCabecera">
            Confirmación de Registro de Incidencia
        </h2>
        <div class="spacer">            
        </div>
    </div> 

    <div class="contenedor-alertas-crud">         
        <% if (typeof mensajeExito !== 'undefined' && mensajeExito) { %>
            <div class="alert-style-crud-ok">
                <span class="icono-check">&#10004;</span>
                <p><%- mensajeExito %></p>
            </div>
        <% } %>
    </div>

    <form class="formularioAlta">
        <div class="fila-mixta">
            <div class="form-group-crud">
                <input class="form-control input-id readonly-style" 
                    type="text" id="idMarcaje" name="idMarcaje"                      
                    value="<%= incidencia.idMarcaje %>" readonly>
                <label class="control-label" for="idMarcaje">ID Fichaje</label>
            </div>                        
        </div>

        <div class="form-group-crud">
            <input class="form-control readonly-style" 
                type="date" id="fechaFich" name="fechaFich"                
                value="<%= incidencia.fecha %>" readonly>
            <label class="control-label" for="fechaFich">Fecha Fichaje</label>
        </div>
        
        <div class="form-group-crud">
            <input class="form-control readonly-style" 
                type="time" id="horaFich" name="horaFich"                 
                value="<%= incidencia.hora.slice(0, 5) %>" readonly>
            <label class="control-label" for="horaFich">Hora Fichaje</label>
        </div>
        
        <div class="form-group-crud" style="margin-bottom: 20px;">
            <input class="form-control readonly-style"
                type="time" id="horaNewFich" name="horaNewFich"                 
                value="<%= incidencia.horaNueva.slice(0, 5) %>" readonly>
            <label class="control-label" for="horaNewFich">Hora Nueva</label>
        </div>            

        <div class="fila-botones">
            <button type="button" 
                hx-get="/trabPanel/incidencias" 
                hx-target="#secContenido"
                hx-push-url="true">
                Volver  
            </button>                    
        </div>
    </form>    
</div>



