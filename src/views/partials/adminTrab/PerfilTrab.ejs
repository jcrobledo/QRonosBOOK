<title><%= title %></title>
<div class="cajasAdminTrabFilter fade-in">
    <div id="contenedorCabecera" class="contenedorCabecera">
        <div class="secMenu">
            <img src="/images/inicio.png" 
                hx-get="/trabPanel" 
                hx-target="#secContenido"
                hx-push-url="true"
                style="cursor:pointer; height:3.5rem; width:3.5rem;"                
                class="iconoScale">            
        </div>
        <h2 class="correcto tituloCabecera">
            Perfil del Trabajador
        </h2>
        <div class="spacer">
            <button type="button"
                hx-get="/trabPanel/changePass" 
                hx-target="#secContenido"
                hx-push-url="true" 
                class="btFichaje btn-perfil">
                Cambiar Contraseña
            </button>           
        </div>
    </div>    

    <form id="formPerfil" class="formularioAlta">

        <div class="fila-mixta">
            <div class="form-group-crud">
                <input class="form-control input-dni readonly-style" type="text" id="ConfirmDni"
                    value="<%= trabajador.dni %>" readonly>
                <label class="control-label" for="ConfirmDni">DNI</label>
            </div>

            <div class="form-group-crud">
                <input class="form-control input-nombre readonly-style" type="text" id="nombre"  
                     value="<%= trabajador.nombre %>" readonly>
                <label class="control-label" for="nombre">Nombre</label>
            </div>
        </div>

        <div class="form-group-crud">
            <input class="form-control readonly-style" type="text" id="apellidos"
                value="<%= trabajador.apellidos %>" readonly>
            <label class="control-label" for="apellidos">Apellidos</label>
        </div>

        <div class="form-group-crud">
            <input class="form-control readonly-style" type="email" id="email" autocomplete="off"
                value="<%= trabajador.email %>" readonly>
            <label class="control-label" for="email">Email</label>
        </div>

        <div class="form-group-crud">
            <input class="form-control readonly-style" type="text" id="departamento"
                value="<%= departamentoNombre %>" readonly>
            <label class="control-label" for="departamento">Departamento</label>
        </div>

        <div class="fila-botones">
            <button type="button" 
                hx-get="/trabPanel" 
                hx-target="#secContenido"
                hx-push-url="true">
                Volver
            </button>                
        </div>
    </form>       
</div>



