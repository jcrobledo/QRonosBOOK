<title><%= title %></title>
<div class="cajasAdminTrabFilter fade-in">
    <div id="contenedorCabecera" class="contenedorCabecera">
        <div class="secMenu">
            <img src="/images/inicio.png" 
                hx-get="/trabPanel" 
                hx-target="#secContenido"
                hx-push-url="true"
                style="cursor:pointer; height:3.5rem; width:3.5rem;"                
                class="iconoScale">            
        </div>
        <h2 class="correcto tituloCabecera">
            Fichajes Mensual
        </h2>    
        <div class="spacer">  
        </div>    
    </div>

    <div class="contenedorDatos">
        <div class="datosTrabajador">    
            <p><strong>Nombre:</strong> <%= trabajador.nombre %></p>
            <p><strong>Apellidos:</strong> <%= trabajador.apellidos %></p>
            <p><strong>DNI:</strong> <%= trabajador.dni %></p>
            <p><strong>Días Trabajados:</strong> <%= fichajes.length %></p>
            <p>
                <strong>Saldo Mensual:</strong> 
                    <span class="<%= esTotalPositivo ? 'SaldoPositivo' : 'SaldoNegativo' %>">
                        <%= saldoTotalMes %>
                    </span>
            </p>
        </div>
    </div>
</div>

<div class="cajasAdminTrabTable fade-in">  

    <div class="navegacion-fecha">    
    
        <span hx-get="/trabPanel/fichajes?fecha=<%= mesAnterior %>&dir=<%= currentDir %>" 
          hx-target="#secContenido"           
          hx-push-url="true"
          class="triangulo-nav">
            &#9664;
        </span>

        <div class="info-fecha-texto">                     
            <input type="month" 
               name="fecha"  
               value="<%= mesConsulta %>"              
               max="<%= mesActual %>"
               required 
               hx-get="/trabPanel/fichajes" 
               onclick="this.showPicker()"
               onkeydown="return false;"
               hx-target="#secContenido"                
               hx-trigger="change"
               hx-push-url="true"
               class="input-calendario-nav">
        </div>
    
        <% if (esMesActual) { %>
            <span class="triangulo-nav triangulo-disabled">
                &#9654;
            </span>
        <% } else { %>
            <span hx-get="/trabPanel/fichajes?fecha=<%= mesSiguiente %>&dir=<%= currentDir %>" 
              hx-target="#secContenido"               
              hx-push-url="true"
              class="triangulo-nav">
                &#9654;
            </span>
        <% } %>

    </div>
 
    <table class="tablaTrabajadoresFichajes">
        <thead>
            <tr>                                                
                <th hx-get="/trabPanel/fichajes?fecha=<%= mesConsulta %>&dir=<%= currentDir === 'ASC' ? 'DESC' : 'ASC' %>"
                    hx-target="#secContenido" 
                    hx-push-url="true"                   
                    class="sort-<%= currentDir.toLowerCase() %>"
                    style="width: 100px;">
                    Día
                </th>
                <th class="no-sort" style="width: 90px;">ID</th>
                <th class="no-sort" style="width: 70px;">Tipo</th>
                <th class="no-sort" style="width: 70px;">Fichaje</th>
                <th class="no-sort" style="width: 60px;">Incidencia</th>
                <th class="no-sort" style="width: 60px;">Saldo</th>                                
            </tr>
        </thead>
        <% fichajes.forEach(function(dia) { %>
            <tbody class="bloque-dia"> 
                <% dia.parejas.forEach(function(p, indice) { %>
                                    
                <!-- Fila Entrada -->
                <tr class="<%= p.entrada.incidencia ? 'fila-con-incidencia' : '' %>">                                       
                    <% if (indice === 0) { %>
                        <td rowspan="<%= dia.parejas.length * 2 %>">
                            <%= dia.fecha %>
                        </td>
                    <% } %>
                    <td><%= p.entrada.id %></td> 
                    <td>Entrada</td>
                    <td><%= p.entrada.hora %></td>
                    <td><%= p.entrada.incidencia %></td>
                    <% if (indice === 0) { %>
                        <td rowspan="<%= dia.parejas.length * 2 %>" class="<%= dia.esPositivo ? 'positivo' : 'negativo' %>">
                            <%= dia.saldo %>
                        </td>
                    <% } %>                    
                </tr>

                <!-- Fila Salida -->
                <tr class="<%= p.salida.incidencia ? 'fila-con-incidencia' : '' %> <%= (indice === dia.parejas.length - 1) ? 'fin-dia' : '' %>">
                    <td><%= p.salida.id %></td>                    
                    <td class="<%= p.salida.hora === '--:--' ? 'falta-fichaje' : '' %>">Salida</td>
                    <td class="<%= p.salida.hora === '--:--' ? 'falta-fichaje' : '' %>"><%= p.salida.hora %></td>
                    <td><%= p.salida.incidencia %></td>
                </tr>

                <% }); %>
            </tbody>
        <% }); %>
    </table>

    <div class="info-paginacion">
    
        <div class="contador-resultados">
            Mostrando <strong><%= desde %></strong> a <strong><%= hasta %></strong> de <strong><%= totalCount %></strong> fichajes
        </div>    
        <div class="botones-paginacion">
            <% if (currentPage > 1) { %>
                <button hx-get="/trabPanel/fichajes?page=<%= currentPage - 1 %>&dir=<%= currentDir %>"                          
                        hx-target="#secContenido"
                        class="btn-pag">Anterior</button>
            <% } %>

            <% if (currentPage < totalPages) { %>
                <button hx-get="/trabPanel/fichajes?page=<%= currentPage + 1 %>&dir=<%= currentDir %>"                          
                        hx-target="#secContenido"
                        class="btn-pag">Siguiente</button>
            <% } %>
        </div>
    </div>

</div>