<title><%= title %></title>
<div class="cajasAdminTrabFilter fade-in">
    <div id="contenedorCabecera" class="contenedorCabecera">
        <div class="secMenu">
            <img src="/images/inicio.png" 
                hx-get="/trabPanel" 
                hx-target="#secContenido"
                hx-push-url="true"
                style="cursor:pointer; height:3.5rem; width:3.5rem;"                
                class="iconoScale">            
        </div>
        <h2 class="correcto tituloCabecera">
            <%= (typeof mensajeOK !== 'undefined' && mensajeOK === 'OK') ? 'Registrar Incidencia de Modificación' : 'Buscar Fichaje a Modificar' %>
        </h2>
        <div class="spacer">            
        </div>
    </div>   

    <% if (typeof mensajeOK === 'undefined' || mensajeOK !== 'OK') { %>
        <div class="contenedor-alertas-crud">            
            <div class="info-style-crud">            
                <span>⚠️</span>
                <p>ID del Fichaje del Trabajador FORMATO numérico AAAAMMDDFFFF</p>
            </div>        
        </div>
    <% } %>

    <form class="formularioAlta"
        hx-post="/trabPanel/incidencias/modificar" 
        hx-target="#secContenido"
        hx-validate="true"         
        hx-push-url="false">

        <div class="fila-mixta-buscar">
            <div class="form-group-crud">
                <input class="form-control input-id <%= (typeof mensajeOK !== 'undefined' && mensajeOK === 'OK') ? 'readonly-style' : '' %>" 
                    type="text" id="idMarcaje" name="idMarcaje" maxlength="12" minlength="12"
                    pattern="[0-9]{12}" autocomplete="off" placeholder=" " required
                    title="Solamente 12 números AAAAMMDDFFFF"
                    value="<%= marcaje ? marcaje.id : idMarcaje %>"
                    <%= (typeof mensajeOK !== 'undefined' && mensajeOK === 'OK') ? 'readonly' : '' %>>
                <label class="control-label" for="idMarcaje">ID Fichaje</label>
            </div>

            <% if (typeof mensajeOK === 'undefined' || mensajeOK !== 'OK') { %>
                <button type="submit" class="btn-buscar">
                    Buscar
                </button>
            <% } %>              
        </div>

        <div class="form-group-crud">
            <input class="form-control readonly-style" type="date" id="fechaFich" name="fechaFich"                
                value="<%= marcaje ? marcaje.date : '' %>" readonly>
            <label class="control-label" for="fechaFich">Fecha Fichaje</label>
        </div>
        
        <div class="form-group-crud <%= (typeof mensajeOK !== 'undefined' && mensajeOK === 'OK') ? '' : 'espacio-mensaje' %>">
            <input class="form-control readonly-style" type="time" id="horaFich" name="horaFich"                 
                value="<%= (marcaje && marcaje.time) ? marcaje.time.slice(0, 5) : '' %>" step="60" readonly>
            <label class="control-label" for="horaFich">Hora Fichaje</label>
        </div>

        <% if (typeof mensajeOK !== 'undefined' && mensajeOK === 'OK') { %>
            <div class="form-group-crud" style="margin-bottom: 20px;">
                <input class="form-control" type="time" id="horaNewFich" name="horaNewFich" 
                    required placeholder=" " title="Seleccione una hora válida" 
                    step="60" onclick="this.showPicker()" onkeydown="return false;">
                <label class="control-label" for="horaNewFich">Hora Nueva</label>
            </div>   
        <% } %>     

        <div class="fila-botones">
            <button type="button" 
                hx-get="<%= urlVolver %>" 
                hx-target="#secContenido"
                hx-push-url="true">
                Volver
            </button>  
            <% if (typeof mensajeOK !== 'undefined' && mensajeOK === 'OK') { %>
                <button type="submit" 
                    class="btn-alta"
                    hx-post="/trabPanel/incidencias/modificarReg" 
                    hx-include=".formularioAlta"
                    hx-target="#secContenido"
                    hx-trigger="click[this.form.checkValidity()]"
                    onclick="if(!this.form.checkValidity()) this.form.reportValidity()">
                    Registrar
                </button>
            <% } %>                
        </div>

    </form>

    <% if (typeof mensajeError !== 'undefined' && mensajeError) { %>
        <div class="contenedor-alertas-crud" id="alertaError" style="margin-top: 20px;"> 
            <div class="alert-style-crud-ko">
                <span>⛔</span>
                <p><%- mensajeError %></p>
            </div>
        </div>
    <% } %> 

</div>

<script>

    (function() {
        const elemento = document.getElementById('alertaError');
        if (elemento) {
            setTimeout(() => {elemento.style.display = 'none';}, 5000);
        }
    })();

</script>

