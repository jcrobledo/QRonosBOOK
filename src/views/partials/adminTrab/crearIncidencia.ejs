<title><%= title %></title>
<div class="cajasAdminTrabFilter fade-in">
    <div id="contenedorCabecera" class="contenedorCabecera">
        <div class="secMenu">
            <img src="/images/inicio.png" 
                hx-get="/trabPanel" 
                hx-target="#secContenido"
                hx-push-url="true"
                style="cursor:pointer; height:3.5rem; width:3.5rem;"                
                class="iconoScale">            
        </div>
        <h2 class="correcto tituloCabecera">
            Incidencia Nuevo Fichaje
        </h2>
        <div class="spacer">            
        </div>
    </div>   

    <form class="formularioAlta"
        hx-post="/trabPanel/incidencias/crear" 
        hx-target="#secContenido" 
        hx-push-url="false">  
        
        <div class="form-group-crud">
            <input class="form-control" type="date" id="fechaInc" name="fechaInc" 
                required placeholder=" " title="Seleccione una fecha válida"
                value="<%= (typeof fechaDesdeFich !== 'undefined' && fechaDesdeFich) ? fechaDesdeFich : '' %>" 
                max="<%= hoy %>" onclick="this.showPicker()" onkeydown="return false;">
            <label class="control-label" for="fechaInc">Fecha Nuevo Fichaje</label>
        </div>

        <div class="form-group-crud" style="margin-bottom: 20px;">
            <input class="form-control" type="time" id="horaInc" name="horaInc" 
                required placeholder=" " title="Seleccione una hora válida" 
                step="60" onclick="this.showPicker()" onkeydown="return false;">
            <label class="control-label" for="horaInc">Hora</label>
        </div>            

        <div class="fila-botones">
            <button type="button" 
                hx-get="<%= urlVolver %>" 
                hx-target="#secContenido"
                hx-push-url="true">
                Volver
            </button>
            <button type="submit">Registrar</button>            
        </div>

    </form>
</div>