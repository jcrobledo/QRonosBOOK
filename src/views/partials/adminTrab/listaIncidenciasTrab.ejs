<title><%= title %></title>
<div class="cajasAdminTrabFilter fade-in">
    <div id="contenedorCabecera" class="contenedorCabecera">
        <div class="secMenu">
            <img src="/images/inicio.png" 
                hx-get="/trabPanel" 
                hx-target="#secContenido"
                hx-push-url="true"
                style="cursor:pointer; height:3.5rem; width:3.5rem;"                
                class="iconoScale">            
        </div>
        <h2 class="correcto tituloCabecera">
            <span class="texto-largo">Gestión de </span>Incidencias
        </h2>    
        <div class="spacer">            
        </div>    
    </div>

    <div class="fila-botones-centro">            
        <button type="button" 
            hx-get="/trabPanel/incidencias/crear" 
            hx-target="#secContenido"
            hx-push-url="true"
            style="width: 200px;">
            Nuevo Marcaje
        </button>
        <button type="button"
            hx-get="/trabPanel/incidencias/modificar"
            hx-target="#secContenido"
            hx-push-url="true" 
            style="width: 200px;">
            Modificar Marcaje
        </button>
        <button type="button"
            hx-get="/trabPanel/incidencias/eliminar"
            hx-target="#secContenido"
            hx-push-url="true"
            style="width: 200px;">
            Eliminar Marcaje
        </button>
    </div>    
</div>

<div class="cajasAdminTrabTable fade-in">     

    <div class="contenedor-filtros-tabla" style="margin-bottom: 10px;">
        
        <div class="selector-segmentado">
            <input type="radio" 
                name="filtro" 
                id="todas" 
                value="todas"
                hx-get="/trabPanel/incidencias"
                hx-target="#secContenido"
                hx-trigger="change" 
                <%= filtros.estado === 'todas' ? 'checked' : '' %>>
            <label for="todas">Todas</label>

            <input type="radio" 
                name="filtro" 
                id="aceptadas" 
                value="aceptada"
                hx-get="/trabPanel/incidencias"
                hx-target="#secContenido"
                hx-trigger="change"
                <%= filtros.estado === 'aceptada' ? 'checked' : '' %>>
            <label for="aceptadas">Aceptadas</label>

            <input type="radio" 
                name="filtro" 
                id="rechazadas" 
                value="rechazada"
                hx-get="/trabPanel/incidencias"
                hx-target="#secContenido"
                hx-trigger="change"
                <%= filtros.estado === 'rechazada' ? 'checked' : '' %>>
            <label for="rechazadas">Rechazadas</label>

            <input type="radio" 
                name="filtro" 
                id="pendientes" 
                value="pendiente"
                hx-get="/trabPanel/incidencias"
                hx-target="#secContenido"
                hx-trigger="change"
                <%= filtros.estado === 'pendiente' ? 'checked' : '' %>>
            <label for="pendientes">Pendientes</label>
        </div>

    </div>

       <table class="tablaTrabajadores">
        <thead>
            <tr>
                <th hx-get="/trabPanel/incidencias?sort=id&dir=<%= currentDir === 'ASC' ? 'DESC' : 'ASC' %>"
                    hx-target="#secContenido"
                    hx-include="[name='filtro']"
                    class="<%= currentSort === 'id' ? 'sort-' + currentDir.toLowerCase() : '' %>" style="width: 110px;">
                ID Inc</th>
                <th hx-get="/trabPanel/incidencias?sort=idMarcaje&dir=<%= currentDir === 'ASC' ? 'DESC' : 'ASC' %>"
                    hx-target="#secContenido"
                    hx-include="[name='filtro']"
                    class="<%= currentSort === 'idMarcaje' ? 'sort-' + currentDir.toLowerCase() : '' %>"> 
                ID Fichaje</th>
                <th hx-get="/trabPanel/incidencias?sort=date&dir=<%= currentDir === 'ASC' ? 'DESC' : 'ASC' %>"
                    hx-target="#secContenido"
                    hx-include="[name='filtro']"
                    class="<%= currentSort === 'date' ? 'sort-' + currentDir.toLowerCase() : '' %>">
                Fecha</th>
                <th hx-get="/trabPanel/incidencias?sort=time&dir=<%= currentDir === 'ASC' ? 'DESC' : 'ASC' %>"
                    hx-target="#secContenido"
                    hx-include="[name='filtro']"
                    class="<%= currentSort === 'time' ? 'sort-' + currentDir.toLowerCase() : '' %>">
                Hora</th>
                <th hx-get="/trabPanel/incidencias?sort=timeChange&dir=<%= currentDir === 'ASC' ? 'DESC' : 'ASC' %>"
                    hx-target="#secContenido"
                    hx-include="[name='filtro']"
                    class="<%= currentSort === 'timeChange' ? 'sort-' + currentDir.toLowerCase() : '' %>">
                Hora Nueva</th>
                <th hx-get="/trabPanel/incidencias?sort=tipoInc&dir=<%= currentDir === 'ASC' ? 'DESC' : 'ASC' %>"
                    hx-target="#secContenido"
                    hx-include="[name='filtro']"
                    class="<%= currentSort === 'tipoInc' ? 'sort-' + currentDir.toLowerCase() : '' %>">
                Tipo Inc</th>
                <th hx-get="/trabPanel/incidencias?sort=resolucion&dir=<%= currentDir === 'ASC' ? 'DESC' : 'ASC' %>"
                    hx-target="#secContenido"
                    hx-include="[name='filtro']"
                    class="<%= currentSort === 'resolucion' ? 'sort-' + currentDir.toLowerCase() : '' %>">
                Resolución</th>
                <th class="no-sort" style="width: 110px;">Acciones</th>
            </tr>
        </thead>
        <tbody id="tablaTrabajadoresBody">
            <% incidencias.forEach(function(incidencia) { %>
            <tr class="<%= incidencia.resolucion === 'Aceptada' ? 'positivo_inc' : (incidencia.resolucion === 'Rechazada' ? 'negativo_inc' : '') %>">
                <td><%= incidencia.id %></td>
                <td><%= incidencia.idMarcaje %></td> 
                <td><%= incidencia.date %></td>  
                <td><%= incidencia.time %></td>  
                <td><%= incidencia.timeChange %></td>                
                <td><%= tipoIncMap[incidencia.tipoInc] ? tipoIncMap[incidencia.tipoInc] : "Sin Tipo" %></td>
                <td><%= incidencia.resolucion %></td>  
                <td class="celda-menu">
                    <button class="btnAcciones">&middot;&middot;&middot;</button>
                    <div class="dropdown-table">
                        <ul>                            
                            <li>
                                <% if (incidencia.resolucion === 'Pendiente') { %>
                                    <a href="javascript:void(0)" onclick="eliminar('<%= incidencia.id %>')">
                                    Eliminar
                                    </a>                                
                                <%  } else { %>    
                                    <span class="incidencia-disabled">Eliminar</span>
                                <% } %>
                            </li>
                        </ul>
                    </div>
                </td>                             
            </tr>
        <% }); %>                
        </tbody>
    </table>

    <div class="info-paginacion">
    
        <div class="contador-resultados">
            Mostrando <strong><%= desde %></strong> a <strong><%= hasta %></strong> de <strong><%= totalCount %></strong> incidencias
        </div>    
        <div class="botones-paginacion">
            <% if (currentPage > 1) { %>
                <button hx-get="/trabPanel/incidencias?page=<%= currentPage - 1 %>&sort=<%= currentSort %>&dir=<%= currentDir %>" 
                        hx-include="[name='filtro']" 
                        hx-target="#secContenido"
                        class="btn-pag">Anterior</button>
            <% } %>

            <% if (currentPage < totalPages) { %>
                <button hx-get="/trabPanel/incidencias?page=<%= currentPage + 1 %>&sort=<%= currentSort %>&dir=<%= currentDir %>" 
                        hx-include="[name='filtro']" 
                        hx-target="#secContenido"
                        class="btn-pag">Siguiente</button>
            <% } %>
        </div>
    </div> 

    <div id="modalConfirmar" hx-swap-oob="true" class="modal-overlay" style="display:none;">
        <div class="modal-content">        
            <h3>¿Eliminar Incidencia PENDIENTE con<br>ID <span id="idModal"></span>?</h3>
            <p>Esta acción es permanente y no se puede deshacer.</p>
        
            <div class="fila-botones"> 
                <button type="button" onclick="document.getElementById('modalConfirmar').style.display='none'">
                    Cancelar
                </button>           
                <button id="btnConfirmarEliminado"
                    type="button" 
                    hx-delete="" 
                    hx-target="#secContenido"
                    hx-push-url="false"
                    hx-on::after-request="document.getElementById('modalConfirmar').style.display='none'">
                Eliminar
                </button>                
            </div>
        </div>
    </div>

</div>

<script>

function eliminar(id) {
    const btn = document.getElementById('btnConfirmarEliminado');
    const modal = document.getElementById('modalConfirmar');  
    const spanId = document.getElementById('idModal');  

    spanId.textContent = id;    
    btn.setAttribute('hx-delete', `/trabPanel/incidencias/deleteInc/${id}`);      
    htmx.process(btn);    
    
    modal.style.display = 'flex';
};

</script>




