<title><%= title %></title>
<div class="cajasAdminTrabFilter fade-in">
    <div id="contenedorCabecera" class="contenedorCabecera">
        <div class="secMenu">
            <img src="/images/inicio.png" 
                hx-get="/trabPanel" 
                hx-target="#secContenido"
                hx-push-url="true"
                style="cursor:pointer; height:3.5rem; width:3.5rem;"                
                class="iconoScale">            
        </div>
        <h2 class="correcto tituloCabecera">
            Confirmación de Registro de Incidencia
        </h2>
        <div class="spacer">            
        </div>
    </div>   

    <div class="contenedor-alertas-crud">
        <div class="alert-style-crud-ok">
            <span class="icono-check">&#10004;</span>
            <p><%- mensajeOK %></p>
        </div>
    </div>

    <form class="formularioAlta">          
        <div class="form-group-crud">
            <input class="form-control readonly-style" type="date" id="fechaInc" name="fechaInc"                
                value="<%= fecha %>" readonly>
            <label class="control-label" for="fechaInc">Fecha Nuevo Fichaje</label>
        </div>

        <div class="form-group-crud" style="margin-bottom: 20px;">
            <input class="form-control readonly-style" type="time" id="horaInc" name="horaInc"                 
                value="<%= hora %>" readonly>
            <label class="control-label" for="horaInc">Hora</label>
        </div>            

        <div class="fila-botones">
            <button type="button" 
                hx-get="/trabPanel/incidencias" 
                hx-target="#secContenido"
                hx-push-url="true">
                Volver
            </button>                       
        </div>
    </form>
    
</div>

<script src="/socket.io/socket.io.js"></script>

<script>

    { // Usamos un bloque para evitar errores de "already declared" por let reloadIncMenuInicio

    let reloadIncMenuInicio = '<%= reloadIncMenuInicio %>';

    if (reloadIncMenuInicio == 'true') {
        const socket = io(); // 1. Conectamos al servidor

        socket.on('connect', () => {
            // console.log("Conectado. Enviando orden de recarga de Menú Inicio Administrador..."); // 2. Esperamos a que la conexión esté lista para emitir      
            socket.emit('SolicitarRecargaMenuInicio'); // 3. Emitimos el evento inmediatamente al entrar
        });
    };

    }   

</script>